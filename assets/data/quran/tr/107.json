{"surah":107,"ayahs":[{"t":"Hesap gününü yalanlayanı gördün mü?","f":null},{"t":"Yetimi itip kakan da işte odur.","f":null},{"t":"Ve yoksulu doyurmaya teşvik etmez.","f":null},{"t":"Vay o namaz kılanların haline ki:","f":null},{"t":"Onlar kıldıkları namazdan gafildirler.","f":null},{"t":"Onlar gösteriş yaparlar.","f":null},{"t":"Hem de mâûnu da vermeyip, engellerler.","f":null}]}