{"surah":81,"ayahs":[{"t":"Güneş dürüldüğü zaman.","f":null},{"t":"Yıldızlar, saçılıp dağıldığı zaman.","f":null},{"t":"Dağlar yürütüldüğü zaman.","f":null},{"t":"Gebe develer başıboş bırakıldığı zaman.","f":null},{"t":"Vahşi hayvanlar bir araya toplandığı zaman.","f":null},{"t":"Denizler tutuşturulduğu zaman.","f":null},{"t":"Nefisler/kişiler (benzerleriyle) birleştirildiği zaman.","f":null},{"t":"Diri diri (toprağa) gömülen kız çocuğuna sorulduğu zaman.","f":null},{"t":"\"Hangi günâhtan dolayı öldürüldü?\" (diye).","f":null},{"t":"Sahifeler (amel defterleri) açıldığı zaman.","f":null},{"t":"Gök, sıyrılıp ayrıldığı zaman.","f":null},{"t":"Cehennem alevlendirildiği zaman.","f":null},{"t":"Ve Cennet yaklaştırıldığı zaman.","f":null},{"t":"Her nefis önceden ne hazırladığını bilecektir.","f":null},{"t":"Hayır! Yemin ederim gizlenen (yıldızlara).","f":null},{"t":"O akıp akıp yörüngesinde giden ve gizlenenlere.","f":null},{"t":"Karardığında geceye.","f":null},{"t":"Aydınlanmaya başladığında sabaha.","f":null},{"t":"Şüphesiz o, çok değerli bir elçinin sözüdür.","f":null},{"t":"Kuvvet sahibi; Arşın sahibinin katında itibarlı (bir elçinin).","f":null},{"t":"Kendine itaat edilen, üstelik güvenilir.","f":null},{"t":"Arkadaşınız bir mecnun değildir.","f":null},{"t":"Onu (Cebrail'i) ufukta apaçık görmüştür.","f":null},{"t":"O, gayp hakkında cimri değildir.","f":null},{"t":"O, kovulmuş Şeytan'ın sözü de değildir.","f":null},{"t":"Öyleyse nereye gidiyorsunuz?","f":null},{"t":"O, yalnızca bütün âlemler için bir öğüttür.","f":null},{"t":"Sizden dosdoğru olmak isteyenler için.","f":null},{"t":"Âlemlerin Rabbi Allah dilemedikçe siz de dileyemezsiniz.","f":null}]}