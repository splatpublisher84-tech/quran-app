{"surah":114,"ayahs":[{"t":"Katakanlah, \"Aku berlindung kepada Tuhannya manusia,","f":null},{"t":"Raja manusia,","f":null},{"t":"sembahan manusia,","f":null},{"t":"dari kejahatan (bisikan) setan yang bersembunyi,","f":null},{"t":"yang membisikkan (kejahatan) ke dalam dada manusia,","f":null},{"t":"dari (golongan) jin dan manusia.\"","f":null}]}